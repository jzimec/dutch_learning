{
  "version": 1,
  "mode": "supervised",
  "model": "gpt-4.1-mini",
  "max_tasks_per_run": 1,
  "max_runtime_minutes": 30,
  "max_agent_turns": 12,
  "max_budget_usd": null,
  "allowed_paths": [
    "dutch-auth.js",
    "styles/**",
    "agent/**",
    "tests/**"
  ],
  "protected_paths": [
    "index.html",
    ".github/workflows/**",
    "supabase/**"
  ],
  "auto_push": false,
  "auto_merge": false,
  "requires_human_review": [
    "production deploy",
    "database migration",
    "authentication policy changes",
    "credential changes",
    "protected path edits"
  ],
  "budget_enforcement": "not_implemented",
  "max_input_chars": 45000,
  "max_output_tokens": 12000
}
